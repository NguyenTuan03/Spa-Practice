# Chỉ cần cho tab "Nâng cao (AI)". Tab Luyện tập chạy không cần biến nào.
# AI_PROVIDER: gemini | openai | openai-compatible (DeepSeek, Groq, OpenRouter...)
AI_PROVIDER=gemini
AI_API_KEY=
# Tên model: lấy đúng từ trang tài liệu của nhà cung cấp
AI_MODEL=
# Chỉ cần với openai-compatible, ví dụ https://api.deepseek.com (provider openai tự dùng api.openai.com)
AI_BASE_URL=
# Khuyên đặt khi deploy công khai để người lạ không dùng hết quota của bạn
ADVANCED_ACCESS_CODE=
# Đặt false để tắt ảnh tự động từ Wikimedia Commons (mặc định bật)
COMMONS_ENABLED=
